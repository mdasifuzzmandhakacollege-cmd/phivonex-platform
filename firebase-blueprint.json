{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Registered PHIVONEX operator and user accounts",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "fullName": { "type": "string", "description": "User legal full name" },
        "email": { "type": "string", "format": "email", "description": "Primary email address" },
        "phone": { "type": "string", "description": "Mobile contact number with country code" },
        "country": { "type": "string", "description": "Country of residence" },
        "referralCode": { "type": "string", "description": "User own referral code" },
        "referredBy": { "type": "string", "description": "Sponsor referral code" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "Account role" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp created" }
      },
      "required": ["uid", "fullName", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents keyed by Auth UID"
    }
  }
}
