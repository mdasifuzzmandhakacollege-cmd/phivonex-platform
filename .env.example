# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# PHIVONEX — TASK #23.2 PRODUCTION INTEGRATION ENVIRONMENT VARIABLES
# ============================================================================

# Environment Type: 'production' | 'staging' | 'test' | 'development'
APP_ENV="development"

# BNB Smart Chain configuration (56 = Mainnet, 97 = Testnet)
BSC_CHAIN_ID=97

# Primary and Secondary BSC RPC urls for high availability and automatic failover
BSC_RPC_URL_PRIMARY="https://bsc-testnet.publicnode.com"
BSC_RPC_URL_SECONDARY="https://data-seed-prebsc-1-s1.binance.org:8545"

# BSC USDT Contract Address (Default is BSC Testnet USDT faucet contract)
USDT_CONTRACT_ADDRESS="0x337610d27c682E347C9cD60BD4b3b107C9d34dDd"

# Moralis API and Webhook credentials for deposit syncing
MORALIS_API_KEY="your_moralis_api_key_here"
MORALIS_WEBHOOK_SECRET="your_moralis_webhook_secret_here"

# Server-side authoritative market price provider key (e.g., CoinMarketCap, Binance or similar)
MARKET_DATA_API_KEY="your_market_data_api_key_here"

# Withdrawal Security Switch (Defaults strictly to 'false' in production unless explicitly 'true')
WITHDRAWALS_ENABLED="false"

# Signer Private Key Reference/Alias (Should resolve to key vault reference or safe environment variable name)
SIGNER_SECRET_REFERENCE="your_signer_secret_alias"

# Master Derivation Seed for generating user static deposit wallets (Deterministic HD Wallet seed)
# MUST be a 12/24 word mnemonic or secure hex seed. Fail-closed if missing in production.
MASTER_DERIVATION_SECRET_REFERENCE="your_master_derivation_mnemonic_or_seed"

