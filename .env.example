# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# PHIVONEX — PRODUCTION LIVE DEPOSIT WALLET & BSC ENVIRONMENT VARIABLES
# ============================================================================

# Application Environment: 'production' | 'staging' | 'test' | 'development'
APP_ENV="production"

# BNB Smart Chain Chain ID (56 = BSC Mainnet, 97 = BSC Testnet)
BSC_CHAIN_ID=56

# Primary & Secondary BSC Mainnet JSON-RPC endpoints for high availability & failover
BSC_RPC_URL_PRIMARY="https://bsc-dataseed.binance.org"
BSC_RPC_URL_SECONDARY="https://bsc-dataseed1.defibit.io"

# Official USDT BEP-20 Contract Address on BNB Smart Chain Mainnet
# Official Binance-Peg BSC-USD / USDT: 0x55d398326f99059ff775485246999027b3197955
USDT_CONTRACT_ADDRESS="0x55d398326f99059ff775485246999027b3197955"

# Public Extended Key (xpub) representing the public branch at m/44'/60'/0'/0
# The app server NEVER holds private keys, seed phrases, mnemonics, or xprv.
# Export this public key from your offline/cold wallet generator.
DEPOSIT_ADDRESS_XPUB="xpub6EF8jXqFeFEW5bwMU7RpQtHkzE4KJxcqJtvkCjJumzW8CPpacXkb92ek4WzLQXjL93HycJwTPUAcuNxCqFPKKU5m5Z2Vq4nCyh5CyPeBFFr"

# Required on-chain block confirmations before crediting deposits (Defaults to 3)
DEPOSIT_CONFIRMATIONS=3

# Treasury Wallet Address where swept USDT is ultimately collected (Separate Cold/Multi-Sig 0x address)
TREASURY_WALLET_ADDRESS="0x71C8705E3473187F6c1aB3c4709d4352D7F338f0"

# Secure Signer Reference / KMS Key Resource Name
# NOTE: The value below is a PLACEHOLDER example URI. Never treat it as a configured signer.
# Private derivation/signing material exists ONLY in your dedicated secure signer / KMS.
SIGNER_SECRET_REFERENCE="gcp-kms://projects/YOUR_GCP_PROJECT_ID_PLACEHOLDER/locations/global/keyRings/YOUR_KEYRING_PLACEHOLDER/cryptoKeys/bsc-signer"

# Withdrawal Security Switch (STRICTLY 'false' until separately approved)
WITHDRAWALS_ENABLED="false"

# Resend Email Integration (Server-side)
RESEND_API_KEY="re_123456789_your_resend_api_key_here"
EMAIL_FROM_ADDRESS="support@phivonex.com"
EMAIL_FROM_NAME="PHIVONEX"
EMAIL_WEBHOOK_SECRET="your_email_webhook_secret_here"
